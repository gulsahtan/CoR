{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LLM": {
    "Provider": "OpenAI",
    "Model": "gpt-4o",
    "Temperature": 0.2,
    "MaxTokens": 2048,
    "OutputLimits": {
      "RootCause": 512,
      "Patch": 2048,
      "Refinement": 2048,
      "DirectPatch": 2048,
      "SelfConsistency": 512,
      "Explanation": 384,
      "PatchLengthRetry": 4096
    },
    "TotalTokenBudget": 16000,
    "MaxCalls": 20
  },
  "AllowedHosts": "*"
}
